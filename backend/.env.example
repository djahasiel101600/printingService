# Django / DRF
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# Business rules
# ------------------------------------------------------------------
# Minimum acceptable partial (down) payment as a percentage of the order total
MIN_PARTIAL_PERCENT=50
# Multiplier applied to the printed-sides price when double-sided is chosen
DUPLEX_DISCOUNT_FACTOR=0.90

# ------------------------------------------------------------------
# Epson Connect API v2  (https://api.epsonconnect.com/api/2)
# ------------------------------------------------------------------
EPSON_MOCK_MODE=True
EPSON_API_BASE=https://api.epsonconnect.com/api/2
EPSON_UPLOAD_BASE=https://upload.epsonconnect.com
EPSON_AUTH_BASE=https://auth.epsonconnect.com
# x-api-key issued when you create an application in the Epson developer portal
EPSON_API_KEY=
# OAuth client credentials for the application token (client_credentials)
EPSON_CLIENT_ID=
EPSON_CLIENT_SECRET=
# Device authorization. GRANT chooses how a device token is obtained:
#   password        -> device-registered email + password (grant_type=password)
#   refresh_token   -> a previously issued refresh token
#   authorization_code -> standard authorization code flow (EPSON_AUTH_CODE)
EPSON_DEVICE_GRANT=password
EPSON_DEVICE_EMAIL=
EPSON_DEVICE_PASSWORD=
EPSON_DEVICE_REFRESH_TOKEN=
EPSON_AUTH_CODE=
# Serial number / label used to identify the shop printer in the UI
EPSON_PRINTER_NAME=Shop Printer

# ------------------------------------------------------------------
# PayMongo (https://developers.paymongo.com) - QR Ph
# ------------------------------------------------------------------
PAYMONGO_MOCK_MODE=True
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public site URL used in QR redirect URLs
FRONTEND_URL=http://localhost:5173

# Email notifications (console backend by default in DEBUG)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=printshop@example.com
