# =============================================================================
# Print Service — docker compose configuration
#
#   cp .env.example .env   (then fill in the secrets below)
#
# Values here are read by docker-compose.yml and passed into the containers.
# Blank secrets keep the app in its mock / default mode.
# =============================================================================

# --- Django / DRF ------------------------------------------------------------
# Generate one (safe characters, no shell/dotenv metacharacters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Quote any value that contains '#' or '$' so docker compose's .env parser
# keeps it intact, e.g.  PASSWORD="p@ss#word".
SECRET_KEY=change-me
DEBUG=False

# Public hostname behind the Cloudflare tunnel (+ internal service names).
# cloudflared forwards the public hostname as the Host header — it MUST be listed.
ALLOWED_HOSTS=print.jdp-homelab.space,printservice-backend,printservice-frontend,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://print.jdp-homelab.space
CSRF_TRUSTED_ORIGINS=https://print.jdp-homelab.space
# Public site URL used in PayMongo QR redirect URLs.
FRONTEND_URL=https://print.jdp-homelab.space

# --- Frontend build (baked into the SPA image) ------------------------------
# Keep "/api" so nginx proxies same-origin requests and no CORS is needed.
VITE_API_URL=/api

# --- Database ----------------------------------------------------------------
# sqlite (default): stored in the printservice-data volume — keeps existing data.
# postgres: set DB_ENGINE=postgres, then run:
#   docker compose --profile postgres up -d --build
DB_ENGINE=sqlite
DB_NAME=printservice
DB_USER=printservice
DB_PASSWORD=change-me
DB_HOST=printservice-db
DB_PORT=5432

# --- Business rules ----------------------------------------------------------
MIN_PARTIAL_PERCENT=50
DUPLEX_DISCOUNT_FACTOR=0.90

# --- Epson Connect API v2 ----------------------------------------------------
EPSON_MOCK_MODE=True
EPSON_API_KEY=
EPSON_CLIENT_ID=
EPSON_CLIENT_SECRET=
EPSON_DEVICE_GRANT=password
EPSON_DEVICE_EMAIL=
EPSON_DEVICE_PASSWORD=
EPSON_DEVICE_REFRESH_TOKEN=
EPSON_AUTH_CODE=
EPSON_PRINTER_NAME=Shop Printer

# --- PayMongo (QR Ph) --------------------------------------------------------
PAYMONGO_MOCK_MODE=True
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Email notifications (optional) ------------------------------------------
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=printshop@example.com

# --- Runtime tuning ----------------------------------------------------------
RUN_MIGRATIONS=true
# Optional: seed pricing rules + the demo accounts on boot (idempotent).
# Prefer the browser first-run wizard at /setup to create the real admin.
RUN_SEED_DEMO=false
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=75
